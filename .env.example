PROJECT_NAME="DealFlow360"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
PORTAL_API_STR="/api/v1/portal"
SECRET_KEY="replace-with-a-secure-random-secret-key-dealflow360-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=720
PORTAL_TOKEN_EXPIRE_MINUTES=240
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=dealflow_secret
POSTGRES_DB=dealflow360
DATABASE_URL=postgresql://dealflow:dealflow_secret@localhost:5432/dealflow360
TEST_DATABASE_URL=postgresql://dealflow:dealflow_secret@localhost:5432/dealflow360_test
CORS_ORIGINS="*"

# Odoo Integration (§3)
DEALFLOW_ODOO_MODE="fake"
ODOO_URL="http://localhost:8069"
ODOO_DB="dealflow_db"
ODOO_VERSION="17.0"
ODOO_API_USER="admin"
ODOO_API_KEY="admin"
ODOO_DEALFLOW_MODULE="dealflow_odoo"
ODOO_WEBHOOK_SECRET="dealflow-webhook-hmac-secret-key-min-32-bytes"
ODOO_PORTAL_TOKEN_SECRET="dealflow-portal-token-hmac-secret-key-min-32-bytes"

# Odoo Custom Fields
PARTNER_TIER_FIELD="x_dealflow_tier"
PARTNER_TEAM_FIELD="team_id"
ORDER_DEAL_ID_FIELD="dealflow_deal_id"
ORDER_APPROVAL_STATE_FIELD="dealflow_approval_state"
ORDER_RISK_SCORE_FIELD="dealflow_risk_score"
ORDER_LOCK_FIELD="dealflow_locked"
ORDER_GLOBAL_DISCOUNT_FIELD=""
LINE_COST_FIELD="purchase_price"
SUBSCRIPTION_MODEL="sale.order"
SUBSCRIPTION_PLAN_FIELD="recurrence_id"

# Role Mapping JSON
ROLE_GROUP_MAP='{"ADMIN": ["base.group_system", "dealflow_odoo.group_dealflow_admin"], "SALES_MANAGER": ["sales_team.group_sale_manager", "dealflow_odoo.group_dealflow_sales_manager"], "SALES_REP": ["sales_team.group_sale_salesman", "dealflow_odoo.group_dealflow_sales_rep"], "FINANCE": ["account.group_account_manager", "dealflow_odoo.group_dealflow_finance"]}'
